{
  "name": "bharat-forensic-suite",
  "version": "2.0.0",
  "description": "BharatAnalyzer: Sovereign Digital Forensics & Financial Intelligence Workbench",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "python scripts/start_all.py",
    "dev:all": "python scripts/start_all.py",
    "backend": "python -m parsers.api_server",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "desktop:dev": "electron .",
    "desktop:build": "powershell -ExecutionPolicy Bypass -File scripts/build_desktop_exe.ps1",
    "package:electron": "electron-builder --win --x64",
    "electron:start": "electron .",
    "test:python": "python -m pytest tests --ignore=tests/e2e",
    "test:ts": "npx jiti ui/tests/workbench_store_test.ts && npx jiti ui/tests/csv_export_test.ts && npx jiti ui/tests/contrast_test.ts && npx jiti ui/tests/ui_shell_test.ts && npx jiti ui/tests/views_5c_test.ts && npx jiti ui/tests/review_step10_test.ts && npx jiti tests/test_forensic_client.ts && npx jiti ui/tests/test_forensic_client.ts"
  },
  "keywords": [
    "forensics",
    "upi",
    "digital-forensics",
    "bharat",
    "phonepe",
    "gpay"
  ],
  "author": "Bharat-PA Forensics Team",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "electron": "^45.2.1",
    "electron-builder": "^25.1.0",
    "lucide-react": "^1.66.0",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "zustand": "^5.0.16"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
